{
  "name": "drink-inventory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate-products": "node scripts/generate-products.js",
    "db:start": "supabase start && node scripts/write-test-env.js",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/write-test-env.js",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:db": "npm run db:reset && vitest run --project db",
    "pretest:e2e": "vite build --mode test",
    "test:e2e": "start-server-and-test \"vite preview --mode test --port 4173\" http://localhost:4173 \"playwright test\"",
    "test:all": "npm run db:start && npm run test:unit && npm run test:db && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.44.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "radix-ui": "^1.6.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.0.0",
    "start-server-and-test": "^3.0.11",
    "supabase": "^2.110.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
